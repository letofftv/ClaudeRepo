{
  "_comment": "Скопировать в tools.local.json (он не попадает в git) и вписать свои пути. Здесь же можно переопределить команду любого инструмента или выключить лишние. В значениях переменных работают ~ и {workdir}.",
  "vars": {
    "tts_url": "http://127.0.0.1:8880/v1",
    "tts_model": "tts-1",
    "whisper_cli": "/opt/whisper.cpp/build/bin/whisper-cli",
    "whisper_model": "/opt/models/ggml-large-v3.bin",
    "sd_bin": "/opt/stable-diffusion.cpp/build/bin/sd",
    "sd_model": "/opt/models/sd15.safetensors",
    "separator_models": "{workdir}/models/audio-separator",
    "piper_voices": "{workdir}/models/piper"
  },
  "tools": [
    {
      "id": "whisper",
      "_comment": "пример: faster-whisper в Docker вместо whisper.cpp. Обёртка добавит --lang <язык> сама, а при auto не добавит ничего; SRT и VTT сделает из JSON, который движок оставит в {out}. Папку пульта монтировать по тому же пути, чтобы пути внутри контейнера совпали.",
      "enabled": false,
      "requires": ["docker"],
      "command": ["{python}", "{repo}/app/tools/whisper_subs.py", "--out", "{out}", "--lang", "{lang}", "--lang-flag=--lang", "--",
                  "docker", "run", "--rm", "--gpus", "all", "-v", "{workdir}:{workdir}", "<образ faster-whisper>", "{input}", "{out}"],
      "params": [
        {"name": "input", "type": "file", "label": "Аудио или видео с речью", "required": true, "accept": ["audio", "video"]},
        {"name": "lang", "type": "choice", "label": "Язык", "choices": ["ru", "en", "auto"], "default": "ru",
         "labels": {"ru": "Русский", "en": "Английский", "auto": "Определить автоматически"}}
      ]
    }
  ],
  "disable": ["upscale_video2x"]
}
