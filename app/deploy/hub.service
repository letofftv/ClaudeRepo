# Home hub as a systemd USER service (no root needed, the updater can restart it).
# Install:
#   mkdir -p ~/.config/systemd/user ~/.config/hub
#   cp hub.service hub-update.service hub-update.timer ~/.config/systemd/user/
#   printf 'HUB_TOKEN=%s\n' "$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')" > ~/.config/hub/env
#   chmod 600 ~/.config/hub/env
#   systemctl --user daemon-reload && systemctl --user enable --now hub.service hub-update.timer
#   sudo loginctl enable-linger "$USER"     # start at boot without a login
# The clone is expected at ~/ClaudeRepo; change the paths below if it lives elsewhere.
[Unit]
Description=Home hub (ClaudeRepo/app)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ClaudeRepo/app
# the user manager starts with a short PATH: pipx tools are in ~/.local/bin, nvidia-smi in WSL in
# /usr/lib/wsl/lib (since 0.4.0 the hub also appends them itself)
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
EnvironmentFile=%h/.config/hub/env
ExecStart=/usr/bin/python3 -m hub --config config/hub.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
